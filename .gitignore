# Binários grandes
images/*.sif
testdata/*.bin

# Hipify generated files (regenerate with scripts/hipify_nvcomp.sh)
hipify-output/nvcomp-hipified/

# Build artifacts
build/

# Python
__pycache__/
*.pyc
.venv/

# OS
.DS_Store
Thumbs.db

# Editor
*.swp
*.swo
*~
.vscode/
.idea/

# Daily benchmark output goes here -- regenerated on demand, never tracked.
results/

# Paper-frozen result snapshots ARE tracked (data backing published figures).
# These re-include patterns put back anything under paper/**/results/.
!paper/**/results/
!paper/**/results/**

# Campaign output under experiments/ IS tracked. This repository is the
# centralizer for campaign work: sweeps and profiling runs land here first and
# move into a paper repository only if they end up in the paper. Without these
# re-includes the blanket results/ rule above silently swallowed them, which is
# why campaign data used to survive only inside paper/ or on a cluster node.
!experiments/**/results/
!experiments/**/results/**
!experiments/**/results-*/
!experiments/**/results-*/**

# R session state -- never tracked.
*.RData
*.Rhistory