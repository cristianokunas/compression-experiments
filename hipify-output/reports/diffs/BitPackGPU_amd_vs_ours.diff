+  // This reduces the number of __syncthreads() calls and takes advantage
+  // of faster wave-level operations on AMD GPUs
+
+  int const tid = threadIdx.x;
+  int const lane_id = amd::wave_lane_id();
+  int const wave_id = amd::wave_id();
+  constexpr int NUM_WAVES = BLOCK_SIZE / amd::WAVEFRONT_SIZE;
+
+  // Wave-level reduction for min (first half of threads)
+  if (tid < BLOCK_SIZE / 2 && tid < blockEnd) {
+    T waveMin = minBuffer[tid];
+    waveMin = amd::wave_reduce_min(waveMin);
+
+    // First lane of each wave writes result back
+    if (amd::is_wave_first_lane()) {
+      minBuffer[wave_id] = waveMin;
+    }
+  }
+
